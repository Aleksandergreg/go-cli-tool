%% Editable source for the rendered SVG beside this file.
sequenceDiagram
    autonumber
    actor Player
    participant CLI as cli.App
    participant Store as profile.Store
    participant Session as game.Session
    participant Factory as game.Factory
    participant Env as Environment
    participant Validator as outcome evaluator
    participant Web as webapp.Server
    actor Browser

    Player->>CLI: opsquest play [route]
    CLI->>Store: Load()
    Store-->>CLI: normalized profile
    CLI->>CLI: select mission and route
    opt play --web
        CLI->>Web: Start(loopback, one-time pairing)
        Browser->>Web: pair and subscribe
    end
    CLI->>Session: Run(mission, profile, factory)
    Session->>Factory: Create(context, mission)
    Factory-->>Session: fresh managed environment
    opt play --web
        Session-->>Web: sanitized attempt snapshot
        Web-->>Browser: current state + SSE updates
    end

    loop Until quit, switch, or complete
        Player->>Session: command or mission control
        alt Session control or navigation
            Session->>Session: hint, status, restart, map, play…
        else Environment command
            Session->>Env: Execute(context, line)
            Env-->>Session: output + practiced commands + pipeline width
            Session->>Store: Save(command practice / achievements)
            Session->>Validator: evaluate mission conditions
            loop State-backed conditions
                Validator->>Env: Observe(context, condition)
                Env-->>Validator: satisfied?
            end
            Validator-->>Session: outcome results
            opt web companion active
                Session-->>Web: sanitized outcome snapshot
                Web-->>Browser: SSE snapshot
            end
            alt Outcomes remain
                Session-->>Player: progress and missing-count guidance
            else Every outcome passes
                Session->>Env: Close()
                Env-->>Session: cleanup complete
                Session->>Store: Save(completion, XP, achievements)
                opt web companion active
                    Session-->>Web: persisted completion snapshot
                    Web-->>Browser: SSE completion
                end
                Session-->>CLI: completed SessionResult
                CLI-->>Player: completion and next route
            end
        end
    end

    Note over Session,Env: Restart closes this environment and creates a fresh attempt.
    Note over Env,Store: Cleanup succeeds before first-completion XP is persisted.
