flowchart LR
    INPUT["Player command line"] --> LINE{"At most 64 KiB?"}
    LINE -- No --> E1["Reject<br/>history unchanged"]
    LINE -- Yes --> HISTORY["Record in bounded<br/>attempt history"]
    HISTORY --> LEX["Lex<br/>quotes · escapes · variables<br/>comments · pipes · redirection"]
    LEX --> PARSE["Parse<br/>pipeline stages and redirects"]
    PARSE --> EXPAND["Expand<br/>virtual globs and arguments"]
    EXPAND --> PREFLIGHT{"Composition and<br/>resource checks pass?"}
    PREFLIGHT -- No --> E2["Reject before dispatch"]
    PREFLIGHT -- Yes --> READ["Read stage input<br/>from prior output or virtual file"]
    READ --> DISPATCH["Go command dispatcher<br/>supported teaching subset only"]
    DISPATCH --> STATE["Virtual state operation<br/>files · env · processes · archives"]
    STATE --> OUTPUT{"Output within limit?"}
    OUTPUT -- No --> E3["Reject bounded output"]
    OUTPUT -- Yes --> REDIRECT{"Virtual output<br/>redirection?"}
    REDIRECT -- Yes --> WRITE["Preflight and write<br/>virtual destination"]
    REDIRECT -- No --> NEXT{"Another pipeline stage?"}
    WRITE --> NEXT
    NEXT -- Yes --> READ
    NEXT -- No --> RESULT["Execution result<br/>output · practiced commands<br/>pipeline width · editor request"]
    RESULT --> VALIDATE["Outcome evaluation<br/>text comparison + Environment.Observe"]

    VFS[("In-memory filesystem")]
    ENV[("Virtual environment")]
    PROC[("Virtual processes")]
    ARC[("Logical archives")]
    STATE --- VFS
    STATE --- ENV
    STATE --- PROC
    STATE --- ARC

    HOST["No host shell<br/>No host path lookup<br/>No external command fallback"]
    HOST -. invariant .-> DISPATCH

    classDef input fill:#172554,color:#ffffff,stroke:#172554,stroke-width:2px
    classDef stage fill:#dbeafe,color:#172554,stroke:#2563eb,stroke-width:2px
    classDef state fill:#dcfce7,color:#14532d,stroke:#16a34a,stroke-width:2px
    classDef decision fill:#fef3c7,color:#78350f,stroke:#d97706,stroke-width:2px
    classDef error fill:#fee2e2,color:#7f1d1d,stroke:#dc2626,stroke-width:2px
    classDef invariant fill:#ede9fe,color:#4c1d95,stroke:#7c3aed,stroke-width:2px

    class INPUT input
    class HISTORY,LEX,PARSE,EXPAND,READ,DISPATCH,RESULT,VALIDATE stage
    class STATE,WRITE,VFS,ENV,PROC,ARC state
    class LINE,PREFLIGHT,OUTPUT,REDIRECT,NEXT decision
    class E1,E2,E3 error
    class HOST invariant
